# Replace all sample credentials before deployment; never commit the real .env.engineering file.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
MINIO_ROOT_USER=shanganadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
SHANGAN_ALLOWED_ORIGINS=https://your-workbench.example
SHANGAN_S3_BUCKET=shangan-artifacts
SHANGAN_S3_ENDPOINT=http://minio:9000
AWS_DEFAULT_REGION=us-east-1

# compose.engineering.yml overrides these to internal service names.
SHANGAN_OLLAMA_URL=http://ollama:11434
SHANGAN_EMBEDDING_MODEL=bge-m3
SHANGAN_EMBEDDING_DIMENSIONS=1024
SHANGAN_QDRANT_URL=http://qdrant:6333
SHANGAN_QDRANT_COLLECTION=shangan_artifacts_v1
SHANGAN_QDRANT_API_KEY=
SHANGAN_RERANKER_URL=http://reranker:8080/rerank
SHANGAN_RERANKER_PROVIDER=tei
SHANGAN_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SHANGAN_RERANKER_API_KEY=
SHANGAN_RERANKER_TIMEOUT=30
SHANGAN_REDIS_URL=redis://redis:6379/0
SHANGAN_DATABASE_URL=postgresql://shangan:CHANGE_ME@postgres:5432/shangan

FOCUS_AI_BASE_URL=http://host.docker.internal:11434/v1
FOCUS_AI_MODEL=qwen2.5:7b
FOCUS_AI_API_KEY=
